# Generate local secrets with: php scripts/setup.php
# This file contains no credentials. Do not commit the generated .env.
COMPOSE_PROJECT_NAME=igreja-app
HTTP_PORT=8080
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=
POSTGRES_DB=igreja
POSTGRES_USER=igreja_admin
POSTGRES_PASSWORD=
APP_DATABASE_USER=igreja_app
# Use a hexadecimal password here: Compose embeds it in DATABASE_URL.
APP_DATABASE_PASSWORD=

# Generate the signing keys with: php scripts/setup-auth.php
JWT_ISSUER=igreja-api
JWT_AUDIENCE=igreja-clients
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://guitupinamba.dev,https://www.guitupinamba.dev
# Explicit opt-in for Web cookie tests over loopback HTTP only. Production stays 0.
AUTH_ALLOW_INSECURE_LOCAL=0
